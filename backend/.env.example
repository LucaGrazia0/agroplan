# Solo backend. Non inserire questi valori nell’app Flutter.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# In locale si può omettere. In cloud usare PostgreSQL (mai nel client).
# DATABASE_URL=postgresql://...
# AGROPLAN_DB_PATH=/var/data/agroplan.db
CORS_ORIGINS=http://localhost:8091,http://127.0.0.1:8091

# Il launcher locale genera un codice monouso: non serve impostarlo qui.
# Per attivazione remota, solo se scelta dall’operatore:
# AGROPLAN_SETUP_TOKEN=<codice casuale di almeno 32 caratteri>
